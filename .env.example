# GEMINI_API_KEY: Required for Gemini AI Assistant responses.
# Configure this in Netlify Site configuration -> Environment variables.
GEMINI_API_KEY=

# APP_URL: Optional base URL for local/custom environments (Netlify provides URL automatically).
APP_URL=

# GITHUB_CLIENT_ID & GITHUB_CLIENT_SECRET: Optional, for GitHub OAuth & 5,000 req/hr API proxy.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
